      "id": "s10_corrected_input",
      "title": "Corrected input and reprocessing",
      "description": "A corrected products_v003.csv (same name as the rejected file, valid header) adds the six missing SKUs. An incremental run loads it; a reprocess run re-evaluates open MISSING_PRODUCT_REF quarantine records, which are then resolved.",
      "depends_on": [
        "s06_catalog_price_update",
        "s07_invalid_product_refs",
        "s09_schema_invalid"
      ],
      "steps": [
        {
          "action": "run",
          "mode": "incremental"
        },
        {
          "action": "run",
          "mode": "reprocess",
          "params": {
            "scope": "quarantine",
            "error_codes": [
