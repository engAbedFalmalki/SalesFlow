# Copy to .env and adjust. Real values never belong in source control.

# development | test | production
SALESFLOW_ENV=development

# SQL Server. Windows authentication by default; set SQL_AUTH=sql for SQL logins (e.g. Docker).
SALESFLOW_SQL_SERVER=localhost\SQLEXPRESS
SALESFLOW_SQL_AUTH=windows
# SALESFLOW_SQL_USER=sa
# SALESFLOW_SQL_PASSWORD=change-me
SALESFLOW_ODBC_DRIVER=ODBC Driver 18 for SQL Server
SALESFLOW_SQL_TRUST_SERVER_CERTIFICATE=true
SALESFLOW_OPS_DB=SalesFlow_Ops
SALESFLOW_DW_DB=SalesFlow_DW

# Pipeline
SALESFLOW_EXTRACT_OVERLAP_SECONDS=300
SALESFLOW_STALE_RUN_AFTER_SECONDS=60

# API (binds to localhost by default)
SALESFLOW_API_HOST=127.0.0.1
SALESFLOW_API_PORT=8000
SALESFLOW_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Run the background worker inside the API process (convenient for local demos).
SALESFLOW_EMBEDDED_WORKER=true
# Public demo: set READ_ONLY=true, or set an ADMIN_TOKEN that mutating requests must send.
SALESFLOW_READ_ONLY=false
# SALESFLOW_ADMIN_TOKEN=generate-a-long-random-value

SALESFLOW_LOG_LEVEL=INFO
SALESFLOW_LOG_FORMAT=json
